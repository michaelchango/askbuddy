# ---- AskBuddy 环境变量示例（复制为 .env.local 使用） ----

# 本地开发使用 mock（Auth/DB/COS/AI 全部走内存占位）
USE_MOCK=true

# ---- 以下为真实 CloudBase 环境配置 ----
# 注意：现网环境 ID 含历史 prdhub 字样，属云资源标识，不可重命名（见 T8）
# CloudBase 环境 ID
CLOUDBASE_ENV_ID=
# CloudBase 服务端密钥（仅服务端，禁止 NEXT_PUBLIC_ 暴露）
CLOUDBASE_SECRET=
# 腾讯云 COS 桶名（存放原型 HTML / 导出文件）—— 当前未使用，原型 HTML 走 objects 表
COS_BUCKET=
COS_REGION=

# ============================================================
# 数据库（M1）
# ============================================================
#
# 三个后端一套契约，选择优先级：USE_MOCK > DB_BACKEND > 默认 nosql。
#   USE_MOCK=true      → 进程内内存表，不连任何外部服务
#   DB_BACKEND=nosql   → CloudBase NoSQL 文档库（默认值，不设即为此）
#   DB_BACKEND=postgres→ CloudBase PostgreSQL 直连（需要 DATABASE_URL）
#   DB_BACKEND=cloudbase→ CloudBase PostgreSQL 经公网网关 SQL 执行接口（B 通道），
#                        复用 CLOUDBASE_SECRET，不依赖 DATABASE_URL。
#
# 【重要】不设置 DB_BACKEND 时行为与 M1 之前完全一致。切 postgres / cloudbase 是显式动作。
DB_BACKEND=

# PostgreSQL 连接串。仅 DB_BACKEND=postgres（直连 PG 协议）需要。
# 注意这与 CLOUDBASE_SECRET 是两套独立凭据：CLOUDBASE_SECRET 是 CloudBase 的 API 密钥，
# 走不了 PG 协议；DB_BACKEND=cloudbase 走网关 SQL 接口，也不需要此串。
# 形如：postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# ---- 以下为可选调参，留空即用默认值 ----

# db.list（接受任意 JS 回调的兜底查询）在 PG 上的单次拉取行数上限。
# 触顶时控制台会打 warn —— 那是「这个调用点该下推成 findMany 了」的信号。
DB_LIST_LIMIT=1000

# 打印每一条实际执行的 SQL。排查「这个查询到底有没有下推」时打开。
DB_LOG_SQL=false

# 连接池大小。Serverless 场景下不宜过大。
DB_POOL_MAX=5

# 是否启用预编译语句。走连接池代理（PgBouncer 等 transaction 模式）时必须为 false。
DB_PG_PREPARE=false

# 向量检索单次扫描的最大行数（仅 DB_BACKEND=postgres 且列为 real[] 时的遗留回退参数；
# cloudbase / 真 pgvector 路径走 SQL 下推的 ORDER BY ... <=> LIMIT，不读此值）。
DB_VECTOR_SCAN_LIMIT=5000

# 向量维度。M4 建 knowledge_entries 前必须用 verify:embedding 实测确认，
# 建表后维度不可逆（改维度只能 drop 重建）。
EMBEDDING_DIM=1024

# ---- PAT（Personal Access Token）哈希盐 ----
# 代码默认值为 askbuddy-pat-v1。
# 存量部署必须显式设为 PAT_SALT=prdflow-pat-v1，否则改名前签发的 Token 全部失效（哈希不可逆）。
PAT_SALT=

# ---- MCP 客户端环境变量（供 mcp/server.ts 使用） ----
# AskBuddy 后端地址与 PAT
ASKBUDDY_BASE_URL=http://localhost:3000
ASKBUDDY_TOKEN=
# 兼容说明：PRDFLOW_BASE_URL / PRDFLOW_TOKEN 为过渡期历史别名，仍被识别（新变量优先），
# 将于 T5 复查时移除，请尽快迁移到 ASKBUDDY_*。
