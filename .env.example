# ---- PrdFlow 环境变量示例（复制为 .env.local 使用） ----

# 本地开发使用 mock（Auth/MySQL/COS/AI 全部走内存占位）
USE_MOCK=true

# ---- 以下为真实 CloudBase 环境配置（Phase 2 接入，当前留空） ----
# CloudBase 环境 ID
CLOUDBASE_ENV_ID=
# CloudBase 服务端密钥（仅服务端，禁止 NEXT_PUBLIC_ 暴露）
CLOUDBASE_SECRET=
# 腾讯云 COS 桶名（存放原型 HTML / 导出文件）
COS_BUCKET=
COS_REGION=
# MySQL 连接串（CloudBase 云数据库）
DATABASE_URL=
