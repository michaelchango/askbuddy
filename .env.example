# ---- AskBuddy 环境变量示例（复制为 .env.local 使用） ----

# 本地开发使用 mock（Auth/MySQL/COS/AI 全部走内存占位）
USE_MOCK=true

# ---- 以下为真实 CloudBase 环境配置（Phase 2 接入，当前留空） ----
# 注意：现网环境 ID 含历史 prdhub 字样，属云资源标识，不可重命名（见 T8）
# CloudBase 环境 ID
CLOUDBASE_ENV_ID=
# CloudBase 服务端密钥（仅服务端，禁止 NEXT_PUBLIC_ 暴露）
CLOUDBASE_SECRET=
# 腾讯云 COS 桶名（存放原型 HTML / 导出文件）—— 当前未使用，M1 接入 CloudBase 存储时启用
COS_BUCKET=
COS_REGION=
# MySQL 连接串（CloudBase 云数据库）
DATABASE_URL=

# ---- PAT（Personal Access Token）哈希盐 ----
# 代码默认值为 askbuddy-pat-v1。
# 存量部署必须显式设为 PAT_SALT=prdflow-pat-v1，否则改名前签发的 Token 全部失效（哈希不可逆）。
PAT_SALT=

# ---- MCP 客户端环境变量（供 mcp/server.ts 使用） ----
# AskBuddy 后端地址与 PAT
ASKBUDDY_BASE_URL=http://localhost:3000
ASKBUDDY_TOKEN=
# 兼容说明：PRDFLOW_BASE_URL / PRDFLOW_TOKEN 为过渡期历史别名，仍被识别（新变量优先），
# 将于 T5 复查时移除，请尽快迁移到 ASKBUDDY_*。
